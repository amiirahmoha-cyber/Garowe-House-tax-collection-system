APP_NAME="GHTCS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Mogadishu
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ghtcs_laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

# ------------------------------------------------------------------
# GHTCS SMS Gateway (see README.md for Golis Telecom / aggregator setup)
# ------------------------------------------------------------------
SMS_ENABLED=false
SMS_API_URL=https://YOUR-PROVIDER-ENDPOINT.example.com/sendsms
SMS_API_USERNAME=YOUR_USERNAME_OR_API_KEY
SMS_API_PASSWORD=YOUR_PASSWORD_OR_API_SECRET
SMS_SENDER_ID=GHTCS
